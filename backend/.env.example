# Google Gemini API key. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_RETRIES=5
GEMINI_REQUEST_TIMEOUT=120
CODING_AGENT_LOG_LEVEL=INFO

# Let the model ground its answers with live Google Search results (true/false)
GEMINI_WEB_SEARCH=true

# The Next.js frontend runs on port 8080, so allow it through CORS.
# Add more comma-separated origins if you serve the frontend elsewhere.
FRONTEND_ORIGIN=http://localhost:8080

# Directory the file/shell tools operate in (default: the dir uvicorn runs from)
# CODING_AGENT_WORKDIR=
